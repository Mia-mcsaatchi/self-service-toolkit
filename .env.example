# ---------------------------------------------------------------------------
# Backend environment variables (main.py). Copy to .env for local dev, or set
# these in your host's dashboard (Render/Fly/etc.) for deployment.
# ---------------------------------------------------------------------------

# OpenAI — powers the tagging pipeline and analytics
OPENAI_API_KEY=sk-...

# --- Supabase auth (Phase A) ---------------------------------------------
# Found in Supabase dashboard → Project Settings → API.
# JWT secret: Project Settings → API → "JWT Secret" (Legacy / HS256).
# This is a SERVER SECRET — never commit it, never expose it to the frontend.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Restrict access to a single email domain (colleagues only).
# Leave blank to allow any authenticated Supabase user.
ALLOWED_EMAIL_DOMAIN=mcsaatchi.com

# Local-only escape hatch: set to "true" to bypass auth entirely and run as a
# single shared "local-dev" user (no Supabase needed). NEVER set this on the
# deployed backend — it disables all access control.
AUTH_DISABLED=false
