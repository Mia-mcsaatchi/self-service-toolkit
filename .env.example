# ---------------------------------------------------------------------------
# Backend environment variables (main.py). Copy to .env for local dev, or set
# these in your host's dashboard (Render/Fly/etc.) for deployment.
# ---------------------------------------------------------------------------

# OpenAI — powers the tagging pipeline and analytics
OPENAI_API_KEY=sk-...

# --- Supabase auth (Phase A) ---------------------------------------------
# Your project's base URL, e.g. https://xxxxxxxx.supabase.co
# Used to verify tokens signed with the new asymmetric keys (ES256/RS256).
SUPABASE_URL=https://your-project.supabase.co

# Legacy shared secret (HS256): Project Settings → API → "JWT Secret".
# Only needed if your project still signs tokens with the legacy secret.
# This is a SERVER SECRET — never commit it, never expose it to the frontend.
# Leave blank if your project uses the new asymmetric signing keys.
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Restrict access to a single email domain (colleagues only).
# Leave blank to allow any authenticated Supabase user.
ALLOWED_EMAIL_DOMAIN=mcsaatchi.com

# --- Saving datasets (Phase B) — optional ---------------------------------
# Service-role key: Project Settings → API → "service_role" (secret).
# SERVER SECRET — never commit it, never put it in the frontend. When unset,
# the save/load feature is disabled and the rest of the app still works.
# Run supabase/schema.sql once to create the table this uses.
SUPABASE_SERVICE_ROLE_KEY=

# Local-only escape hatch: set to "true" to bypass auth entirely and run as a
# single shared "local-dev" user (no Supabase needed). NEVER set this on the
# deployed backend — it disables all access control.
AUTH_DISABLED=false
